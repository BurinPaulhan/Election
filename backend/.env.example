# Backend AEMA — variables d'environnement (modèles uniquement, AUCUNE valeur réelle)

# Port HTTP du serveur Express
PORT=3000

# Connexion PostgreSQL (utilisateur applicatif dédié, jamais le superutilisateur)
DATABASE_URL=postgresql://aema_app:CHANGE_ME@127.0.0.1:5432/aema_campaign

# Origine(s) autorisée(s) par CORS — séparées par des virgules si plusieurs
FRONTEND_URL=http://localhost:5173

# Secret de signature des JWT — valeur aléatoire longue (64+ caractères)
JWT_SECRET=CHANGE_ME

# Durée de validité des tokens (exemples : 1h, 8h, 1d)
JWT_EXPIRES_IN=8h

# Identifiants du premier administrateur (utilisés par `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME